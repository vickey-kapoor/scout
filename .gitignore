# Secrets — never commit
.env
.env.*
!.env.example
*.key
*.pem

# Terraform — state can contain secrets; tfvars has your project settings
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Agent run logs
traces/

# Python
.venv/
__pycache__/
*.pyc

# Agent memory (SQLite)
scout.db
# old memory file from the first memory version
memory.db

# Saved Terraform plans (can contain sensitive values)
tfplan
*.tfplan
